{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "mcp": {
    "offline-wikipedia": {
      "type": "local",
      "command": [
        ".\\.venv\\Scripts\\python.exe",
        "-m",
        "offline_rag.mcp_server",
        "--database",
        "indexes\\wikipedia\\enwiki-20260801-full.sqlite3",
        "--vector-index",
        "indexes\\wikipedia\\enwiki-20260801-semantic-full",
        "--models",
        "config\\models.json",
        "--default-retrieval",
        "hybrid",
        "--query-cache-size",
        "256"
      ],
      "environment": {
        "PYTHONPATH": "rag\\src"
      },
      "enabled": true,
      "timeout": 30000
    },
