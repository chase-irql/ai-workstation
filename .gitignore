# Large or generated data
/models/**
/corpora/raw/**
/corpora/processed/**
/indexes/**
/results/runs/**
/results/suites/**
/results/rag/**
/results/ollama-environment-snapshot.json
/runtime/**
/config/harnesses/codex-home/**
!/config/harnesses/codex-home/config.toml

# Keep directory placeholders
!/models/.gitkeep
!/corpora/raw/.gitkeep
!/corpora/processed/.gitkeep
!/indexes/.gitkeep
!/results/runs/.gitkeep
!/results/suites/.gitkeep
!/runtime/.gitkeep

# Local caches
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
node_modules/
*.log

# Local credentials and machine-specific secrets
.env
.env.*
!.env.example
*.pem
*.key
credentials*.json
secrets*.json

# Large model, database, vector, and archive formats
*.faiss
*.gguf
*.onnx
*.safetensors
*.sqlite3
*.db
*.zim
*.7z
*.bz2
*.gz
*.xz
*.zip
*.zst
*.part
